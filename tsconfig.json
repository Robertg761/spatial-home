{
  // Scripts run directly by Node. The apps and packages each have their own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["scripts"]
}
