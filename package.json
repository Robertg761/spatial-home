{
  "name": "spatial-home",
  "private": true,
  "description": "An interactive digital twin that gives smart homes an understanding of physical space",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "editor": "npm run dev -w @spatial-home/editor",
    "mobile": "npm run start -w @spatial-home/mobile",
    "build": "npm run build -w @spatial-home/editor",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ha:check": "node --env-file-if-exists=.env scripts/ha-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
