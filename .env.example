# Copy to .env for `npm run ha:check`. .env is git-ignored; never commit a real token.
HA_URL=http://homeassistant.local:8123
# Create one in Home Assistant: your profile → Security → Long-lived access tokens.
HA_TOKEN=

# No Home Assistant? `npm run ha:sim` uses a simulated home instead; nothing here is needed.
# Optional tuning for it (and for `npm run ha:check -- --simulate`):
# HA_SIM_SPEED=60      simulated seconds per real second
# HA_SIM_SEED=1        fix the randomness to repeat a run
# HA_SIM_FIXTURE=path  a JSON home of your own instead of the demo home
